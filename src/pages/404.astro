---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" noindex={true}>
  <section class="section-pad bg-surface"><div class="container-page py-12 text-center"><p class="text-7xl font-black text-blue-100">404</p><h1 class="heading-lg mt-4">No encontramos esta página.</h1><p class="lead mx-auto mt-5 max-w-xl">La dirección puede haber cambiado o no existir. Puedes volver al inicio o explorar nuestros servicios.</p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="/" class="btn btn-primary">Volver al inicio</a><a href="/servicios" class="btn btn-secondary">Ver servicios</a></div></div></section>
</BaseLayout>
