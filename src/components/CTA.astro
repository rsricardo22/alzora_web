---
import { ArrowRight } from '@lucide/astro';
interface Props { title?: string; text?: string; }
const { title = 'Conversemos sobre el siguiente paso de tu operación.', text = 'Cuéntanos qué proceso quieres mejorar. Te ayudaremos a ordenar el problema y evaluar un camino viable.' } = Astro.props;
---
<section class="section-pad">
  <div class="container-page overflow-hidden rounded-3xl bg-brand-dark px-6 py-12 text-white shadow-soft sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-10">
    <div class="max-w-2xl"><p class="text-sm font-bold uppercase tracking-widest text-blue-300">Diagnóstico inicial</p><h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2><p class="mt-4 leading-7 text-slate-300">{text}</p></div>
    <a href="/contacto" class="btn mt-7 shrink-0 bg-white text-brand-dark hover:bg-blue-50 lg:mt-0">Solicitar diagnóstico <ArrowRight size={18} aria-hidden="true" /></a>
  </div>
</section>
