---
interface Props { eyebrow?: string; title: string; description?: string; align?: 'left' | 'center'; }
const { eyebrow, title, description, align = 'left' } = Astro.props;
---
<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="heading-lg mt-3">{title}</h2>
  {description && <p class="lead mt-5">{description}</p>}
</div>
