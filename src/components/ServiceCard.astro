---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
interface Props { service: Service; }
const { service } = Astro.props;
---
<article class="card group flex h-full flex-col p-6 transition hover:-translate-y-1 hover:shadow-soft">
  <div class="grid size-12 place-items-center rounded-xl bg-blue-50 text-brand"><Icon name={service.icon} /></div>
  <h3 class="heading-md mt-5">{service.title}</h3>
  <p class="muted mt-3 flex-1">{service.summary}</p>
  <a href={`/servicios/${service.slug}`} class="mt-5 inline-flex items-center gap-2 font-bold text-brand">Ver servicio <Icon name="arrow" size={18} /></a>
</article>
