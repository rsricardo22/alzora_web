---
import { navItems, site, whatsappUrl } from '../config/site';
import { services } from '../data/services';
---
<footer class="bg-brand-dark text-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <img src="/brand/alzora-logo-light.svg" width="152" height="38" alt="ALZORA" loading="lazy" />
      <p class="mt-5 max-w-xs text-sm leading-7 text-slate-300">{site.tagline}</p>
      <p class="mt-2 text-sm leading-7 text-slate-400">Soluciones B2B para operaciones más claras, conectadas y eficientes.</p>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-widest text-blue-200">Empresa</h2>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        {navItems.slice(1).map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-widest text-blue-200">Servicios</h2>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        {services.map((service) => <li><a class="hover:text-white" href={`/servicios/${service.slug}`}>{service.shortTitle}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-widest text-blue-200">Contacto</h2>
      <a class="mt-4 block text-sm text-slate-300 hover:text-white" href={`mailto:${site.email}`}>{site.email}</a>
      {whatsappUrl ? <a class="mt-3 block text-sm text-slate-300 hover:text-white" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a> : <p class="mt-3 text-xs text-slate-400">WhatsApp pendiente de configuración.</p>}
      <p class="mt-3 text-sm text-slate-300">Atención a empresas en Perú.</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} ALZORA. Todos los derechos reservados.</p>
      <div class="flex flex-wrap gap-5"><a class="hover:text-white" href="/privacidad">Política de privacidad</a><a class="hover:text-white" href="/tratamiento-datos">Tratamiento de datos</a></div>
    </div>
  </div>
</footer>
