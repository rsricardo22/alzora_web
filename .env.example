# Variables publicas (disponibles durante npm run build)
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_COMPANY_EMAIL=contacto@alzorasolutions.com
# Solo digitos con codigo de pais, por ejemplo 51XXXXXXXXX
PUBLIC_WHATSAPP_NUMBER=

# Variables secretas de Cloudflare Pages Functions (configurar en el panel, no en Git)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=ALZORA Web <contacto@alzorasolutions.com>
ALLOWED_ORIGIN=https://alzorasolutions.com

# Mientras falten PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, RESEND_API_KEY
# o CONTACT_TO_EMAIL, el formulario se muestra como no disponible y el servidor
# rechaza el envio: nunca se simula una entrega.
